# Copie para android/keystore.properties e preencha com os dados da SUA keystore.
# Este arquivo (o .properties real) e o .jks NUNCA vão para o git (ver .gitignore).
#
# Gere a keystore uma única vez (guarde o .jks e as senhas em local seguro —
# perder a keystore = não conseguir mais atualizar o app publicado):
#
#   keytool -genkeypair -v -keystore mealfy-release.jks \
#           -alias mealfy -keyalg RSA -keysize 2048 -validity 10000
#
# Depois pegue o SHA-1/SHA-256 (necessários para Google/Facebook login):
#   keytool -list -v -keystore mealfy-release.jks -alias mealfy

storeFile=mealfy-release.jks
storePassword=COLOQUE_A_SENHA_DA_KEYSTORE
keyAlias=mealfy
keyPassword=COLOQUE_A_SENHA_DA_CHAVE
