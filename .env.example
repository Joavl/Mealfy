# PC: pode usar localhost SE npm run dev:api estiver rodando
# Celular/Expo: OBRIGATORIO o IP da Wi-Fi (ipconfig), ex:
# VITE_API_URL=http://192.168.0.101:3000
VITE_API_URL=http://192.168.0.101:3000
VITE_DISABLE_LOCAL_FALLBACK=false

# Firebase (web) — preencher após criar projeto no console.firebase.google.com
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
