{
  "name": "mealfy-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --lan",
    "start:tunnel": "expo start --tunnel",
    "start:clear": "expo start --lan --clear -c",
    "android": "expo start --android --lan",
    "ios": "expo start --ios --lan",
    "web": "expo start --web",
    "build:apk": "cd .. && npm run build:apk",
    "prebuild:android": "expo prebuild --platform android --clean"
  },
  "dependencies": {
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.0",
    "expo-build-properties": "^56.0.14",
    "expo-constants": "~18.0.0",
    "expo-font": "~14.0.0",
    "expo-linking": "~8.0.0",
    "expo-location": "~19.0.0",
    "expo-router": "~6.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
