# ==============================================================================
# MEALFY — VARIÁVEIS DE AMBIENTE PARA PRODUÇÃO / VPS HOSTINGER
# ==============================================================================

# ─── 1. DOMÍNIOS E URLs PÚBLICAS ──────────────────────────────────────────────
APP_DOMAIN=app.mealfy.org
API_DOMAIN=api.mealfy.org
VITE_API_URL=https://api.mealfy.org
APP_URL=https://app.mealfy.org
CORS_ORIGIN=https://app.mealfy.org

# ─── 2. BANCO DE DADOS (SUPABASE POSTGRESQL) ──────────────────────────────────
# Copie os mesmos valores que você já possui no seu painel da Hostinger / Supabase
DATABASE_URL=
DIRECT_URL=

# ─── 3. SUPABASE FRONTEND (SE APLICÁVEL) ──────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── 4. SEGURANÇA E AUTENTICAÇÃO (JWT) ────────────────────────────────────────
# Copie do painel existente ou gere com: openssl rand -hex 32
JWT_SECRET=
STEP_UP_OTP_HMAC_KEY=
JWT_EXPIRES_IN=15m
ENCRYPTION_KEY=

# ─── 5. MODO DO AMBIENTE (APP_ENV) ────────────────────────────────────────────
APP_ENV=staging
PAYMENT_PROVIDER=mock
DIRECT_PIX_MODE=synthetic
DIRECT_PIX_SYNTHETIC_EVPS=00000000-0000-0000-0000-000000000001
GIFT_CARD_PROVIDER=manual_inventory
GIFT_CARD_ORDER_STALE_MINUTES=15
EMAIL_DELIVERY_MODE=capture
EMAIL_CAPTURE_DIR=.tmp/mail-capture
