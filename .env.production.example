# ==============================================================================
# MEALFY — VARIÁVEIS DE AMBIENTE PARA PRODUÇÃO / VPS HOSTINGER
# ==============================================================================
# Instruções:
# 1. Copie este arquivo para .env no servidor VPS:
#    cp .env.production.example .env
# 2. Preencha seus domínios e gere senhas seguras (ex: openssl rand -hex 32).
# ==============================================================================

# ─── 1. DOMÍNIOS E URLs PÚBLICAS (OBRIGATÓRIO) ───────────────────────────────
# Domínio do Frontend Web (ex: mealfy.seudominio.com ou mealfy.com)
APP_DOMAIN=app.seudominio.com

# Domínio da API Backend (ex: api.mealfy.seudominio.com ou api.seudominio.com)
API_DOMAIN=api.seudominio.com

# URL que o frontend chamará (usada no build do React):
VITE_API_URL=https://api.seudominio.com

# URL pública do Frontend (usada pelo backend para links de confirmação e reset de senha)
APP_URL=https://app.seudominio.com

# CORS: origens permitidas (ou * para liberar geral)
CORS_ORIGIN=https://app.seudominio.com,http://localhost:5173

# ─── 2. BANCO DE DADOS POSTGRESQL (DOCKER) ───────────────────────────────────
POSTGRES_DB=mealfy
POSTGRES_USER=postgres
# Gere uma senha forte: openssl rand -hex 16
POSTGRES_PASSWORD=altere_para_uma_senha_forte_aqui

# ─── 3. SEGURANÇA E AUTENTICAÇÃO (JWT) ──────────────────────────────────────
# Gere com: openssl rand -hex 32
JWT_SECRET=gere_uma_chave_aleatoria_com_openssl_rand_hex_32

# Chave HMAC para OTP step-up (exatamente 64 chars hex; nunca reutilize JWT_SECRET)
STEP_UP_OTP_HMAC_KEY=gere_outra_chave_hex_64_chars_com_openssl_rand_hex_32
JWT_EXPIRES_IN=15m

# Chave legada de criptografia
ENCRYPTION_KEY=chave_aleatoria_32_bytes

# ─── 4. MODO DO AMBIENTE (APP_ENV) ──────────────────────────────────────────
# Opções: staging | production
# NOTA: Em 'production', o backend exige SMTP real configurado para envio de e-mails.
# Se ainda não configurou SMTP, utilize 'staging' para testes iniciais na VPS.
APP_ENV=staging

# ─── 5. PAGAMENTOS E DIRECT PIX ─────────────────────────────────────────────
# mock (testes sem dinheiro real) | stripe (Pix e cartões reais)
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=
PIX_EXPIRATION_MINUTES=30

# Se PAYMENT_PROVIDER=stripe:
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Direct Pix mode: synthetic (staging/dev) | disabled | live (produção aprovada)
DIRECT_PIX_MODE=synthetic
DIRECT_PIX_SYNTHETIC_EVPS=00000000-0000-0000-0000-000000000001

# ─── 6. GIFT CARDS ───────────────────────────────────────────────────────────
GIFT_CARD_PROVIDER=manual_inventory
GIFT_CARD_ORDER_STALE_MINUTES=15

# ─── 7. E-MAIL / NOTIFICAÇÕES ────────────────────────────────────────────────
# capture (salva localmente sem envio) | allowlist | smtp (envio real)
EMAIL_DELIVERY_MODE=capture
EMAIL_CAPTURE_DIR=.tmp/mail-capture
EMAIL_ALLOWLIST=

# Se EMAIL_DELIVERY_MODE=smtp (obrigatório se APP_ENV=production):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mealfy <nao-responda@seudominio.com>"

# ─── 8. LOGIN SOCIAL (OPCIONAL) ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
APPLE_CLIENT_ID=
