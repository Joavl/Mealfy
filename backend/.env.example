# Server Configuration
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:5173

# Database & Auth Modes (allowed values: AUTH_MODE=firebase|mock, DATABASE_MODE=prisma|memory)
AUTH_MODE=mock
DATABASE_MODE=memory

# PostgreSQL Database (required in production or if DATABASE_MODE=prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mealfy?schema=public

# Firebase configuration (required in production or if AUTH_MODE=firebase)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
