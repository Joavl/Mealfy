# ─────────────────────────────────────────────────────────────
# Mealfy Backend — variáveis de ambiente (copie para .env)
# ─────────────────────────────────────────────────────────────

# Núcleo da API
# Classificação de deploy obrigatória: development | ci | demo | staging | production.
# Não é inferida de NODE_ENV e uma classificação ausente/inválida bloqueia o boot.
APP_ENV=development
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# Banco de dados (Fase 1B em diante) — PostgreSQL (Supabase/Railway/Render/local)
# Ex.: postgresql://user:password@host:5432/mealfy?schema=public
DATABASE_URL=

# Autenticação (Fase 2) — ainda não usados na fundação
JWT_SECRET=
# Access token lifetime. Keep short; password resets revoke prior sessions.
JWT_EXPIRES_IN=15m
ENCRYPTION_KEY=

# Pagamentos (Fase 5)
#  mock   → Pix fictício (dev/staging), não movimenta dinheiro real
#  stripe → Pix e cartão reais; cartão é o caminho do Google Pay / Apple Pay
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=
PIX_EXPIRATION_MINUTES=30

# Stripe — OBRIGATÓRIOS quando PAYMENT_PROVIDER=stripe (o boot falha sem eles).
#  1. Dashboard do Stripe → Developers → API keys → Secret key (sk_test_... / sk_live_...)
#  2. Developers → Webhooks → criar endpoint POST {API}/payments/webhook
#     Eventos: payment_intent.succeeded, payment_intent.payment_failed,
#              payment_intent.canceled, charge.refunded
#     Copiar o "Signing secret" (whsec_...) para STRIPE_WEBHOOK_SECRET
#  3. Google Pay: habilitar em Settings → Payment methods (o Stripe é o gateway
#     que recebe o cartão tokenizado da carteira; não há chave extra do Google)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Gift card provider (Fase 7)
#  manual_inventory → estoque importado à mão (implementado, síncrono)
#  stub             → fornecedor FICTÍCIO assíncrono, só dev/staging; serve para
#                     exercitar o fluxo de emissão assíncrona antes do real
#  ifood_card / todo_incomm / incentive_me / ding_connect → pendência comercial
#                     (fornecedor ainda não escolhido; lançam 501 se usados)
# Este é o provider PADRÃO, usado por qualquer marca sem override abaixo.
GIFT_CARD_PROVIDER=manual_inventory

# Override de provider POR MARCA — permite operar em MODO MISTO durante a
# transição para um fornecedor real. Formato: marca:provider,marca:provider
# Marcas: ifood | ninetynine | carrefour
# Ex.: iFood por API e o resto em estoque manual:
#   GIFT_CARD_PROVIDER_BY_BRAND=ifood:ifood_card
# Config malformada é rejeitada no boot.
GIFT_CARD_PROVIDER_BY_BRAND=

# Reconciliação de pedidos presos: quanto tempo um pedido pode ficar sem código
# antes de virar pendência humana (com alerta). Curto demais escala pedido que
# ia concluir sozinho; longo demais deixa o doador esperando sem ninguém saber.
# Dispare por cron: POST /admin/gift-card-orders/reconcile
GIFT_CARD_ORDER_STALE_MINUTES=15

# Segurança de dados e e-mail
# Fora de produção: capture (zero egress) ou allowlist. SMTP irrestrito falha no boot.
EMAIL_DELIVERY_MODE=capture
# Caixa postal local sem egress; mantenha fora do Git e com acesso restrito.
EMAIL_CAPTURE_DIR=.tmp/mail-capture
# Obrigatória somente quando EMAIL_DELIVERY_MODE=allowlist; endereços exatos separados por vírgula.
EMAIL_ALLOWLIST=
# Modo obrigatório: disabled | synthetic | live. Fora de produção, use disabled/synthetic;
# produção aceita disabled/live. Apenas EVP sintéticas canônicas explicitamente configuradas
# são aceitas fora de produção e payloads MEALFY-NONPAYABLE nunca são BR Codes.
DIRECT_PIX_MODE=synthetic
DIRECT_PIX_SYNTHETIC_EVPS=00000000-0000-0000-0000-000000000001
# Produção exige todos os gates explicitamente true antes de coletar/revelar EVP real.
DIRECT_PIX_CONTROLLER_APPROVED=false
DIRECT_PIX_LEGAL_BASIS_APPROVED=false
DIRECT_PIX_TERMS_APPROVED=false
DIRECT_PIX_RETENTION_APPROVED=false
DIRECT_PIX_OPERATIONS_APPROVED=false
# Modo live também exige referências/versionamentos não vazios para as aprovações registradas.
DIRECT_PIX_CONTROLLER_APPROVAL_REF=
DIRECT_PIX_LEGAL_BASIS_APPROVAL_REF=
DIRECT_PIX_TERMS_VERSION=
DIRECT_PIX_RETENTION_POLICY_VERSION=
DIRECT_PIX_OPERATIONS_RUNBOOK_REF=

# Password reset delivery — Gmail SMTP with an App Password (never your Gmail password).
# Em produção use EMAIL_DELIVERY_MODE=smtp e configure todos os campos abaixo.
# Enable 2-Step Verification on the sender account and create an App Password.
APP_URL=https://app.example.com
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_MINUTES=30
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# URLs públicas (deploy)
ADMIN_URL=

# ─────────────────────────────────────────────────────────────
# Login social (Fase 8) — cada provedor só liga quando suas credenciais existem.
# Sem credenciais, o endpoint responde 501 provider_not_configured (não quebra o boot).
# ─────────────────────────────────────────────────────────────
# Papel padrão de quem se cadastra via login social (donor | entity)
OAUTH_DEFAULT_ROLE=donor

# Google — Google Cloud Console → Credenciais → Client ID Web (usado como `aud`)
GOOGLE_CLIENT_ID=

# Facebook/Meta — Meta for Developers → App → Configurações
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Apple — Services ID configurado no Apple Developer (client_id / `aud`)
APPLE_CLIENT_ID=

# Gov.br — credenciais obtidas no portal (exige CNPJ). staging antes de production.
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=
GOVBR_REDIRECT_URI=
GOVBR_ENV=staging