{
    "name":  "mealfy-backend",
    "version":  "0.1.0",
    "description":  "Mealfy MVP backend â€” Express + TypeScript + Prisma + PostgreSQL. Independente do app mobile.",
    "main":  "dist/server.js",
    "scripts":  {
                    "dev":  "ts-node-dev --respawn --transpile-only src/server.ts",
                    "build":  "prisma generate \u0026\u0026 tsc -p tsconfig.json",
                    "start":  "node dist/server.js",
                    "typecheck":  "tsc --noEmit",
                    "typecheck:seed":  "tsc -p tsconfig.seed.json",
                    "prisma:generate":  "prisma generate",
                    "prisma:migrate":  "prisma migrate dev",
                    "prisma:deploy":  "prisma migrate deploy",
                    "prisma:seed":  "ts-node prisma/seed.ts",
                    "prisma:studio":  "prisma studio",
                    "regions:import":  "ts-node prisma/importRegions.ts"
                },
    "prisma":  {
                   "seed":  "ts-node prisma/seed.ts"
               },
    "keywords":  [
                     "mealfy",
                     "backend",
                     "express",
                     "prisma"
                 ],
    "license":  "UNLICENSED",
    "private":  true,
    "dependencies":  {
                         "@prisma/client":  "^5.22.0",
                         "bcryptjs":  "^3.0.3",
                         "cors":  "^2.8.5",
                         "dotenv":  "^16.4.7",
                         "express":  "^4.21.2",
                         "express-async-errors":  "^3.1.1",
                         "express-rate-limit":  "^8.6.0",
                         "helmet":  "^8.3.0",
                         "jsonwebtoken":  "^9.0.3",
                         "stripe":  "^22.3.2",
                         "zod":  "^3.23.8"
                     },
    "devDependencies":  {
                            "@types/bcryptjs":  "^2.4.6",
                            "@types/cors":  "^2.8.17",
                            "@types/express":  "^4.17.21",
                            "@types/jsonwebtoken":  "^9.0.10",
                            "@types/node":  "^22.9.0",
                            "prisma":  "^5.22.0",
                            "ts-node":  "^10.9.2",
                            "ts-node-dev":  "^2.0.0",
                            "typescript":  "^5.6.3"
                        }
}
