// Mealfy MVP — Prisma schema (Fase 1C: schema inicial completo)
//
// Convenções:
// - Valores monetários em CENTAVOS (Int) para evitar problemas de ponto flutuante.
// - Provider 99: enum interno `ninetynine`; UI pública exibe "99 Mercado".
// - Nomes de tabela em snake_case via @@map.
// - Regras de negócio (1x/dia, liberar vale só após pagamento, elegibilidade 0–17)
//   são autoritativas nos SERVIÇOS do backend (Fases 2–5), não só no schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────── ENUMS ───────────────────────────

enum UserRole {
  donor
  entity
  beneficiary
  admin
}

enum UserStatus {
  active
  pending
  suspended
  blocked
}

enum GiftCardProvider {
  ifood
  ninetynine // "99 Mercado" na UI
  carrefour
}

enum FamilyApprovalStatus {
  pending
  approved
  rejected
  blocked
}

enum FamilyVerificationStatus {
  unverified
  gov_mock
  manual
}

enum FamilySupportStatus {
  needs_help
  supported
  fed
}

enum DataSource {
  gov
  manual
}

enum LocationPrecision {
  approximate
  exact_admin_only
}

enum DonationStatus {
  pending_payment
  payment_confirmed
  gift_card_purchase_pending
  gift_card_reserved
  gift_card_released
  completed
  manual_review
  failed
  canceled
  refunded
}

enum GiftCardProviderName {
  manual_inventory
  todo_incomm // pendência comercial — fornecedor ainda não escolhido
  incentive_me // pendência comercial — fornecedor ainda não escolhido
  ding_connect // pendência comercial — fornecedor ainda não escolhido
  ifood_card // pendência comercial — fornecedor ainda não escolhido
  stub
}

enum GiftCardOrderStatus {
  pending
  processing
  issued
  failed
  manual_review
  canceled
}

enum PaymentStatus {
  pending
  paid
  expired
  canceled
  failed
  refunded
}

enum PaymentMethod {
  pix
  /// Cartão — inclui Google Pay/Apple Pay, que são carteiras que entregam um
  /// cartão tokenizado ao gateway (não são meios de pagamento próprios).
  card
}

enum GiftCardStatus {
  available
  reserved
  used
  expired
  invalid
}

enum RecurringStatus {
  active
  paused
  canceled
}

enum OAuthProvider {
  google
  facebook
  apple
  govbr
}

enum StepUpPurpose {
  view_pix_key
  change_pix_key
  revoke_pix_key
  confirm_direct_pix_receipt
}

enum EntityOperatorStatus {
  active
  suspended
  revoked
}

enum FamilyResponsibleAssignmentEndReason {
  reassigned
  relationship_ended
  account_inactive
  data_correction
}

/// A submission is immutable; only a separately authorized reviewer can advance it.
enum DirectPixEvpKeyVersionStatus {
  AWAITING_RESPONSIBLE_CONFIRMATION
  PENDING_REVIEW
  SECOND_APPROVAL_REQUIRED
  ACTIVE
  REJECTED
  SUSPENDED
  REVOKED
  SUPERSEDED
}

/// Direct Pix roll-out controls. All product behavior is fail-closed when a
/// required flag is absent or cannot be read.
enum DirectPixFeatureFlagKey {
  ONBOARDING
  CREATION
  DISCLOSURE
  JOBS
  LEGACY_WRITE
  KILL_SWITCH
}

enum DirectPixFeatureFlagScope {
  GLOBAL
  ENTITY
  FAMILY
}

enum DirectPixIntentStatus {
  OPEN
  DONOR_DECLARED
  CANCELED_BY_DONOR
  FAMILY_CONFIRMED
  FOLLOW_UP_REQUIRED
}

enum DirectPixDeclarationCancellationReason {
  TRANSFER_NOT_SENT
  DONOR_CHANGED_MIND
  OTHER
}

enum DirectPixReceiptOutcome {
  RECEIVED_EXACT
  RECEIVED_DIFFERENT
  NOT_LOCATED
}

enum DirectPixAssistedChannel {
  IN_PERSON
  PHONE
}

enum DirectPixFollowUpReason {
  RECEIVED_DIFFERENT
  NOT_LOCATED
  CONFIRMATION_TIMEOUT
  OLD_QR_DECLARATION
}

enum DirectPixFollowUpCaseStatus {
  OPEN
}

enum FamilySupportCycleStatus {
  IN_PROGRESS
}

// ─────────────────────────── MODELS ───────────────────────────

model User {
  id              String     @id @default(uuid())
  name            String
  email           String     @unique
  emailVerifiedAt DateTime?
  passwordHash    String?
  // Incremented on password reset; invalidates JWTs issued before the reset.
  sessionVersion  Int        @default(0)
  role            UserRole
  avatarUrl       String?
  instagram       String?
  phone           String?
  // CPF verificado pelo Gov.br (só preenchido em login social Gov.br). Único quando presente.
  cpf             String?    @unique
  status          UserStatus @default(active)
  // Preferências de visibilidade no ranking — opt-in explícito (default: não aparece)
  showOnRanking   Boolean    @default(false)
  showInstagram   Boolean    @default(false)
  anonymousMode   Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  donorProfile              DonorProfile?
  entity                    Entity?
  favorites                 Favorite[]
  beneficiaryFamilies       Family[]                   @relation("FamilyBeneficiary")
  oauthAccounts             OAuthAccount[]
  rankingStory              RankingStory?
  passwordResetTokens       PasswordResetToken[]
  emailVerificationTokens   EmailVerificationToken[]
  stepUpChallenges          StepUpChallenge[]
  stepUpAuthorizations      StepUpAuthorization[]
  directPixEvpKeyVersions   DirectPixEvpKeyVersion[]
  directPixEvpKeyReviews    DirectPixEvpKeyReview[]
  directPixTermsAcceptances DirectPixTermsAcceptance[]
  idempotencyRecords        IdempotencyRecord[]
  directPixActions          DirectPixOperatorAction[]   @relation("DirectPixActionActor")
  entityOperatorMemberships EntityOperatorMembership[] @relation("EntityOperatorUser")
  invitedEntityOperators    EntityOperatorMembership[] @relation("EntityOperatorInviter")
  entityOperatorInvitations EntityOperatorInvitation[] @relation("EntityOperatorInvitationAcceptor")
  sentEntityOperatorInvitations EntityOperatorInvitation[] @relation("EntityOperatorInvitationInviter")
  familyResponsibleAssignments FamilyResponsibleAssignment[] @relation("FamilyResponsibleUser")
  invitedFamilyResponsibleAssignments FamilyResponsibleAssignment[] @relation("FamilyResponsibleAssignmentInviter")
  familyResponsibleInvitations FamilyResponsibleInvitation[] @relation("FamilyResponsibleInvitationAcceptor")
  sentFamilyResponsibleInvitations FamilyResponsibleInvitation[] @relation("FamilyResponsibleInvitationInviter")
  updatedDirectPixFeatureFlags DirectPixFeatureFlag[] @relation("DirectPixFeatureFlagUpdater")
  inAppNotifications          InAppNotification[]
  directPixIntents            DirectPixIntent[]
  directPixDisclosureGrants   PixDisclosureGrant[]
  directPixDeclarations       DirectPixDeclaration[]
  directPixDeclarationCancellations DirectPixDeclarationCancellation[]
  directPixReceiptDeclarations DirectPixReceiptConfirmation[] @relation("DirectPixReceiptDeclarant")
  directPixAssistedReceipts    DirectPixReceiptConfirmation[] @relation("DirectPixReceiptOperator")

  @@map("users")
}

/// Identidade social vinculada a um usuário. Um usuário pode ter vários provedores
/// (Google, Facebook, Apple, Gov.br) apontando para a mesma conta Mealfy.

/// Reset-password proof: only a SHA-256 digest is persisted, so a database
/// disclosure cannot be used directly as a reset link. A token is single use.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Email ownership proof. Only a SHA-256 digest is persisted. Tokens are
/// owner-bound, expiring, invalidated on resend and consumed at most once.
model EmailVerificationToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  deliveredAt DateTime?
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

/// Password + email OTP proof for one direct Pix purpose and optional resource.
/// Codes are hash-only, expire after ten minutes and have bounded attempts.
model StepUpChallenge {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose        StepUpPurpose
  resourceId     String?
  codeHash       String        @unique
  sessionVersion Int
  expiresAt      DateTime
  deliveredAt    DateTime?
  failedAttempts Int           @default(0)
  consumedAt     DateTime?
  invalidatedAt  DateTime?
  createdAt      DateTime      @default(now())

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
  @@map("step_up_challenges")
}

/// Short purpose/resource-bound authorization emitted only after a valid OTP.
model StepUpAuthorization {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose        StepUpPurpose
  resourceId     String?
  tokenHash      String        @unique
  sessionVersion Int
  expiresAt      DateTime
  revokedAt      DateTime?
  // One sensitive action consumes a proof; validation alone never consumes it.
  consumedAt     DateTime?
  createdAt      DateTime      @default(now())

  @@index([userId, purpose, resourceId, expiresAt])
  @@index([expiresAt])
  @@map("step_up_authorizations")
}

model OAuthAccount {
  id             String        @id @default(uuid())
  provider       OAuthProvider
  // ID do usuário no provedor (`sub` do ID token / id do Graph). Estável por provedor.
  providerUserId String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  // E-mail retornado pelo provedor no momento do vínculo (pode divergir do e-mail da conta).
  email          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

model DonorProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicSlug          String   @unique
  totalDonations      Int      @default(0) // centavos
  totalFamiliesHelped Int      @default(0)
  rankingPosition     Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("donor_profiles")
}

/// Uma posição manual do Top 20, sempre vinculada a um usuário do tipo doador.
model RankingStory {
  id        String   @id @default(uuid())
  donorId   String   @unique
  donor     User     @relation(fields: [donorId], references: [id], onDelete: Cascade)
  position  Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
  @@map("ranking_stories")
}

model Entity {
  id              String     @id @default(uuid())
  userId          String     @unique
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  cnpj            String     @unique
  responsibleName String
  email           String
  phone           String?
  status          UserStatus @default(pending)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  families            Family[]
  operatorMemberships EntityOperatorMembership[]
  operatorInvitations EntityOperatorInvitation[]
  directPixActions     DirectPixOperatorAction[]
  directPixFeatureFlags DirectPixFeatureFlag[]

  @@map("entities")
}

model EntityOperatorMembership {
  id              String               @id @default(uuid())
  entityId        String
  entity          Entity               @relation(fields: [entityId], references: [id], onDelete: Cascade)
  userId          String
  user            User                 @relation("EntityOperatorUser", fields: [userId], references: [id], onDelete: Cascade)
  status          EntityOperatorStatus @default(active)
  permissions     String[]
  invitedByUserId String?
  invitedByUser   User?                @relation("EntityOperatorInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  activatedAt     DateTime?            @default(now())
  suspendedAt     DateTime?
  revokedAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  directPixActions DirectPixOperatorAction[]
  directPixEvpReviews DirectPixEvpKeyReview[]

  @@unique([entityId, userId])
  @@index([userId, status])
  @@index([entityId, status])
  @@map("entity_operator_memberships")
}

/// Accountable operator authority for Pix-key submit/review/follow-up actions.
/// Review services must reject the membership that submitted the same resource version.
model DirectPixOperatorAction {
  id           String                    @id @default(uuid())
  entityId     String
  entity       Entity                    @relation(fields: [entityId], references: [id], onDelete: Restrict)
  membershipId String
  membership   EntityOperatorMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  actorUserId  String
  actorUser    User                      @relation("DirectPixActionActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  resourceType String
  resourceId   String
  action       String
  createdAt    DateTime                  @default(now())

  @@index([resourceType, resourceId, action])
  @@index([entityId, createdAt])
  @@map("direct_pix_operator_actions")
}

model EntityOperatorInvitation {
  id               String    @id @default(uuid())
  entityId         String
  entity           Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  email            String
  tokenHash        String    @unique
  permissions      String[]
  invitedByUserId  String
  invitedByUser    User      @relation("EntityOperatorInvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedByUserId String?
  acceptedByUser   User?     @relation("EntityOperatorInvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  expiresAt        DateTime
  acceptedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([entityId, email])
  @@index([expiresAt])
  @@map("entity_operator_invitations")
}

/// Historical authority record. PostgreSQL partial unique indexes ensure exactly one active
/// responsible per family and one active family per responsible account.
model FamilyResponsibleAssignment {
  id                String                             @id @default(uuid())
  familyId          String
  family            Family                             @relation(fields: [familyId], references: [id], onDelete: Restrict)
  responsibleUserId String
  responsibleUser   User                               @relation("FamilyResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  invitationId      String?                            @unique
  invitation        FamilyResponsibleInvitation?       @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  invitedByUserId   String
  invitedByUser     User                               @relation("FamilyResponsibleAssignmentInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  assignedAt        DateTime                           @default(now())
  endedAt           DateTime?
  endReason         FamilyResponsibleAssignmentEndReason?
  evpKeyVersions    DirectPixEvpKeyVersion[]

  @@index([familyId, endedAt])
  @@index([responsibleUserId, endedAt])
  @@map("family_responsible_assignments")
}

/// Bearer invitations are account-bound by normalized e-mail; only the hash is stored.
model FamilyResponsibleInvitation {
  id               String   @id @default(uuid())
  familyId         String
  family           Family   @relation(fields: [familyId], references: [id], onDelete: Restrict)
  email            String
  tokenHash        String   @unique
  invitedByUserId  String
  invitedByUser    User     @relation("FamilyResponsibleInvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedByUserId String?
  acceptedByUser   User?    @relation("FamilyResponsibleInvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  expiresAt        DateTime
  acceptedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime @default(now())

  assignment       FamilyResponsibleAssignment?

  @@index([familyId, email])
  @@index([expiresAt])
  @@map("family_responsible_invitations")
}

/// Município brasileiro, importado do IBGE — a lista canônica de áreas.
///
/// Antes, "área" só existia se alguma família tivesse sido cadastrada ali, e o
/// nome era texto livre digitado no cadastro: "Heliópolis", "heliopolis" e
/// "Heliopolis " viravam três lugares diferentes. Aqui a chave é o código IBGE,
/// então o município existe independentemente de haver família nele.
///
/// O bairro/comunidade continua sendo texto livre em `Family` — é informação
/// que o IBGE não fornece e que só quem cadastra conhece.
model Region {
  id         String   @id @default(uuid())
  /// Código IBGE do município (7 dígitos). Identidade estável e oficial.
  ibgeCode   Int      @unique
  name       String
  /// Nome sem acento e em minúsculas, só para busca.
  ///
  /// `contains` com `mode: insensitive` resolve caixa, mas NÃO acento: quem
  /// digitasse "sao paulo" não encontrava "São Paulo" — inaceitável, já que a
  /// maioria dos municípios brasileiros tem acento. Coluna dedicada resolve sem
  /// depender da extensão `unaccent` do Postgres.
  nameSearch String   @default("")
  /// UF em duas letras (SP, RJ...).
  state      String
  /// Centroide da malha do IBGE. Nulo até ser buscado sob demanda: são 5.571
  /// municípios e baixar a geometria de todos de uma vez seria lento e inútil,
  /// já que só interessa onde existe família.
  latitude   Float?
  longitude  Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  families    Family[]
  communities Community[]

  @@index([state])
  @@index([nameSearch])
  @@map("regions")
}

/// De onde veio a coordenada da comunidade.
///
/// Registrar a origem é o que impede o app de apresentar um palpite como se
/// fosse localização confirmada: `region_centroid` é literalmente o centro do
/// município, não o lugar.
enum CommunitySource {
  /// Encontrada no OpenStreetMap (base colaborativa, NÃO governamental).
  osm
  /// Só o texto que o cadastro informou; sem coordenada própria.
  declared
  /// Sem correspondência no OSM: herda o centro do município.
  region_centroid
}

/// Comunidade/favela/bairro dentro de um município — "Cidade de Deus",
/// "Heliópolis", "Rocinha".
///
/// Existe porque o município é grande demais para o doador saber a quem está
/// doando: "Rio de Janeiro" não diz nada, "Cidade de Deus" diz tudo. O IBGE não
/// publica esse nível como API (`/localidades/favelas` responde 404; a base de
/// Favelas e Comunidades Urbanas do Censo 2022 só sai como arquivo), então a
/// coordenada vem do OpenStreetMap e a origem fica gravada em `source`.
///
/// O nome continua sendo digitado por quem cadastra — ninguém escolhe de uma
/// lista fechada, porque lista fechada nenhuma cobre as comunidades do país.
/// `nameSearch` + unicidade por município é o que evita "Heliópolis",
/// "heliopolis" e "Heliopolis " virarem três lugares no mapa.
model Community {
  id         String          @id @default(uuid())
  regionId   String
  region     Region          @relation(fields: [regionId], references: [id], onDelete: Cascade)
  /// Como foi digitado da primeira vez — é o que aparece na tela.
  name       String
  /// Minúsculo e sem acento; só para deduplicar e buscar.
  nameSearch String
  latitude   Float?
  longitude  Float?
  source     CommunitySource @default(declared)
  /// Identificador OSM da área, quando houve correspondência. Guardado para
  /// permitir reconferir a origem depois sem refazer a busca por nome.
  osmId      String?
  /// Quando tentamos geocodificar pela última vez. Nulo = nunca tentamos.
  /// Sem isso, uma comunidade que o OSM não conhece seria reconsultada a cada
  /// carregamento do mapa.
  geocodedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  families Family[]

  @@unique([regionId, nameSearch])
  @@index([regionId])
  @@map("communities")
}

model Family {
  id                        String                   @id @default(uuid())
  responsibleName           String
  displayName               String
  entityId                  String?
  entity                    Entity?                  @relation(fields: [entityId], references: [id])
  nisMasked                 String?
  cpfMasked                 String?
  /// Município oficial. Passa a ser a fonte da posição no mapa — a família é
  /// mostrada na região, não no endereço, o que também expõe menos.
  regionId                  String?
  region                    Region?                  @relation(fields: [regionId], references: [id])
  /// Mantidos por compatibilidade e para exibição: continuam preenchidos, mas
  /// quem manda no mapa agora é `region`.
  city                      String
  state                     String
  /// Comunidade/favela onde a família mora — é isto que o doador vê no mapa,
  /// porque o município sozinho não diz a quem ele está doando.
  communityId               String?
  communityRef              Community?               @relation(fields: [communityId], references: [id])
  /// Bairro/comunidade como texto — continua sendo o que o cadastro digita, e é
  /// a partir de `community` que a `Community` acima é resolvida. Mantidos
  /// porque são a entrada crua: se a resolução mudar de regra, o texto original
  /// ainda está aqui.
  neighborhood              String?
  community                 String?
  approximateAddress        String?
  fullAddressEncrypted      String? // só admin; criptografado em repouso
  latitude                  Float?
  longitude                 Float?
  locationPrecision         LocationPrecision        @default(approximate)
  preferredGiftCardProvider GiftCardProvider?
  /// Marca escolhida na solicitação do dia. Só vale junto com
  /// `supportRequestedAt`: sem pedido no ciclo atual, o fallback é o preferido.
  todayRequestedProvider    GiftCardProvider?
  /// Quando a família pediu apoio pela última vez.
  ///
  /// O pedido vale por UM ciclo (reset 08h SP) e expira sozinho — é isso que
  /// impede a solicitação de amanhecer já feita. Antes só existia
  /// `todayRequestedProvider`, que nunca expirava: uma vez gravado, a família
  /// constava como tendo pedido para sempre.
  supportRequestedAt        DateTime?
  supportStatus             FamilySupportStatus      @default(needs_help)
  lastFedAt                 DateTime?
  lastDonationId            String?
  lastDonorId               String?
  lastDonorName             String?
  lastDonorInstagram        String?
  lastGiftCardProvider      GiftCardProvider?
  verificationStatus        FamilyVerificationStatus @default(unverified)
  approvalStatus            FamilyApprovalStatus     @default(pending)
  dataSource                DataSource               @default(manual)
  socialDescription         String?
  needToday                 Boolean                  @default(true)
  beneficiaryUserId         String?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  dependents      FamilyDependent[]
  responsibleAssignments FamilyResponsibleAssignment[]
  responsibleInvitations FamilyResponsibleInvitation[]
  directPixEvpKeyVersions DirectPixEvpKeyVersion[]
  directPixFeatureFlags DirectPixFeatureFlag[]
  directPixIntents DirectPixIntent[]
  directPixSupportCycles FamilySupportCycle[]
  directPixFollowUpCases DirectPixFollowUpCase[]
  beneficiaryUser User?             @relation("FamilyBeneficiary", fields: [beneficiaryUserId], references: [id], onDelete: SetNull)

  @@index([approvalStatus])
  @@index([entityId])
  @@index([beneficiaryUserId])
  @@map("families")
}

/// Direct Pix EVP aggregate. Neither raw EVP nor civil-holder details are stored.
/// Persisted Direct Pix flags. Scope resolution is family → entity → global.
/// `pilot` configuration may only be enabled at family scope; the service
/// enforces a ten-family hard cap per flag and entity.
model DirectPixFeatureFlag {
  id              String                      @id @default(uuid())
  key             DirectPixFeatureFlagKey
  scope           DirectPixFeatureFlagScope
  entityId        String?                     @map("entity_id")
  entity          Entity?                     @relation(fields: [entityId], references: [id], onDelete: Cascade)
  familyId        String?                     @map("family_id")
  family          Family?                     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  enabled         Boolean                     @default(false)
  config          Json?
  version         Int                         @default(1)
  updatedByUserId String                      @map("updated_by_user_id")
  updatedByUser   User                        @relation("DirectPixFeatureFlagUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime                    @default(now()) @map("created_at")
  updatedAt       DateTime                    @updatedAt @map("updated_at")

  @@index([key, scope])
  @@index([entityId, key])
  @@index([familyId, key])
  @@map("direct_pix_feature_flags")
}

model DirectPixEvpKeyVersion {
  id             String                       @id
  familyId       String
  family         Family                       @relation(fields: [familyId], references: [id], onDelete: Restrict)
  assignmentId   String
  assignment     FamilyResponsibleAssignment  @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  submittedByUserId String
  submittedByUser User                        @relation(fields: [submittedByUserId], references: [id], onDelete: Restrict)
  version        Int
  status         DirectPixEvpKeyVersionStatus @default(PENDING_REVIEW)
  aadVersion     Int                          @default(1)
  encryptionKid  String
  nonce          String
  ciphertext     String
  tag            String
  fingerprintKid String
  fingerprint    String
  submittedAt    DateTime                     @default(now())
  reviews        DirectPixEvpKeyReview[]
  directPixIntents DirectPixIntent[]

  @@unique([familyId, version])
  @@index([familyId, status, submittedAt])
  @@index([assignmentId, submittedAt])
  @@index([fingerprintKid, fingerprint])
  @@map("direct_pix_evp_key_versions")
}

/// Immutable, minimum-evidence onsite review decision. The expected holder name remains encrypted.
enum DirectPixEvpReviewDecision {
  APPROVE
  REJECT
}

enum DirectPixEvpReviewReason {
  EXACT_NAME_MATCH
  ABBREVIATED_NAME
  SOCIAL_NAME
  CIVIL_NAME_UPDATE
  HOLDER_NAME_MISMATCH
  EVP_MISMATCH
  OTHER_MISMATCH
}

model DirectPixEvpKeyReview {
  id                         String                    @id
  keyVersionId               String                    @map("key_version_id")
  keyVersion                 DirectPixEvpKeyVersion   @relation(fields: [keyVersionId], references: [id], onDelete: Restrict)
  reviewerUserId             String                    @map("reviewer_user_id")
  reviewerUser               User                      @relation(fields: [reviewerUserId], references: [id], onDelete: Restrict)
  reviewerMembershipId       String                    @map("reviewer_membership_id")
  reviewerMembership         EntityOperatorMembership  @relation(fields: [reviewerMembershipId], references: [id], onDelete: Restrict)
  sequence                   Int
  decision                   DirectPixEvpReviewDecision
  reason                     DirectPixEvpReviewReason
  expectedNameEncryptionKid  String                    @map("expected_name_encryption_kid")
  expectedNameNonce          String                    @map("expected_name_nonce")
  expectedNameCiphertext     String                    @map("expected_name_ciphertext")
  expectedNameTag            String                    @map("expected_name_tag")
  createdAt                  DateTime                  @default(now()) @map("created_at")

  @@unique([keyVersionId, sequence])
  @@index([reviewerMembershipId, createdAt])
  @@map("direct_pix_evp_key_reviews")
}

model FamilyDependent {
  id              String   @id @default(uuid())
  familyId        String
  family          Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name            String
  age             Int
  relationship    String?
  isEligibleMinor Boolean  @default(false) // true quando age entre 0 e 17
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([familyId])
  @@map("family_dependents")
}

model Donation {
  id            String           @id @default(uuid())
  donorId       String
  familyId      String
  amount        Int // centavos
  provider      GiftCardProvider
  status        DonationStatus   @default(pending_payment)
  paymentId     String?          @unique
  giftCardId    String?          @unique
  failureReason String?
  createdAt     DateTime         @default(now())
  completedAt   DateTime?
  canceledAt    DateTime?

  messages DonationMessage[]

  @@index([donorId])
  @@index([familyId])
  @@index([status])
  @@map("donations")
}

enum DonationMessageAuthor {
  donor
  beneficiary
}

/// Mensagem trocada em torno de uma doação. Nesta versão o conteúdo é sempre
/// escolhido de uma lista fixa (ver `messages.templates.ts`): não existe texto
/// livre, o que evita expor famílias vulneráveis a conteúdo de estranhos sem
/// nenhuma moderação.
///
/// Guarda a CHAVE do template e também o TEXTO renderizado no momento do envio:
/// a chave garante que só mensagens previstas entrem (validação no servidor), e
/// o texto congela o que a pessoa de fato enviou — se o template for reescrito
/// depois, o histórico não muda de sentido retroativamente.
model DonationMessage {
  id          String                @id @default(uuid())
  donationId  String
  donation    Donation              @relation(fields: [donationId], references: [id], onDelete: Cascade)
  author      DonationMessageAuthor
  templateKey String
  body        String
  createdAt   DateTime              @default(now())

  // Um envio por lado, por doação — evita repetição e mantém a leitura simples.
  @@unique([donationId, author])
  @@index([donationId])
  @@map("donation_messages")
}

model Payment {
  id                String        @id @default(uuid())
  donationId        String        @unique
  provider          String // nome do gateway (mock no MVP)
  method            PaymentMethod @default(pix)
  status            PaymentStatus @default(pending)
  amount            Int
  pixQrCode         String?
  pixCopyPaste      String?
  externalPaymentId String?       @unique
  expiresAt         DateTime?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  events PaymentEvent[]

  @@index([status])
  @@map("payments")
}

model PaymentEvent {
  id              String    @id @default(uuid())
  paymentId       String
  payment         Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  externalEventId String    @unique // garante idempotência do webhook
  eventType       String
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([paymentId])
  @@map("payment_events")
}

model GiftCard {
  id            String           @id @default(uuid())
  provider      GiftCardProvider
  codeEncrypted String // nunca em claro
  codeMasked    String // ex.: "****-1234"
  codeHash      String           @unique // anti-duplicidade na importação
  amount        Int
  status        GiftCardStatus   @default(available)
  batchId       String? // opcional: cards de fornecedor externo não têm batch de import manual
  batch         GiftCardBatch?   @relation(fields: [batchId], references: [id])
  reservedAt    DateTime?
  usedAt        DateTime?
  expiresAt     DateTime?
  donationId    String?          @unique
  familyId      String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([provider, status])
  @@index([batchId])
  @@map("gift_cards")
}

model GiftCardBatch {
  id               String           @id @default(uuid())
  provider         GiftCardProvider
  batchName        String
  importedByUserId String
  totalCodes       Int
  amount           Int
  createdAt        DateTime         @default(now())

  giftCards GiftCard[]

  @@map("gift_card_batches")
}

// Histórico de tentativas de emissão de gift card (1 doação pode ter várias
// linhas — uma por tentativa — até chegar em `issued` ou ficar em
// `manual_review`). `provider` é a MARCA do cartão (enum existente);
// `externalProvider` é o FORNECEDOR/integração que tentou emitir.
model GiftCardOrder {
  id                  String               @id @default(uuid())
  donationId          String
  familyId            String
  provider            GiftCardProvider
  externalProvider    GiftCardProviderName @default(manual_inventory)
  externalOrderId     String?
  idempotencyKey      String               @unique
  amount              Int
  currency            String               @default("BRL")
  status              GiftCardOrderStatus  @default(pending)
  failureReason       String?
  rawRequestMetadata  Json?
  rawResponseMetadata Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([donationId])
  @@index([familyId])
  @@index([status])
  @@map("gift_card_orders")
}

model GiftCardEvent {
  id         String   @id @default(uuid())
  giftCardId String
  eventType  String // imported | reserved | released | invalidated | resent
  userId     String?
  donationId String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([giftCardId])
  @@map("gift_card_events")
}

model Favorite {
  id        String   @id @default(uuid())
  donorId   String
  donor     User     @relation(fields: [donorId], references: [id], onDelete: Cascade)
  familyId  String
  createdAt DateTime @default(now())

  @@unique([donorId, familyId])
  @@map("favorites")
}

model RecurringSupportIntent {
  id                   String          @id @default(uuid())
  donorId              String
  familyId             String
  status               RecurringStatus @default(active)
  type                 String          @default("daily_reminder")
  requiresConfirmation Boolean         @default(true)
  maxDailyAmount       Int?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([donorId])
  @@map("recurring_support_intents")
}

model AuditLog {
  id             String    @id @default(uuid())
  actorUserId    String?
  actorRole      UserRole? @map("actor_role")
  action         String
  entityType     String
  entityId       String?
  channel        String?
  correlationId  String?   @map("correlation_id")
  idempotencyKey String?   @map("idempotency_key")
  result         String?
  metadata       Json?
  createdAt      DateTime  @default(now())

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model DirectPixTermsVersion {
  id          String   @id @default(uuid())
  version     String   @unique
  title       String
  statements  Json
  publishedAt DateTime @map("published_at")
  effectiveAt DateTime @map("effective_at")
  isCurrent   Boolean  @default(false) @map("is_current")
  createdAt   DateTime @default(now()) @map("created_at")

  acceptances DirectPixTermsAcceptance[]

  @@map("direct_pix_terms_versions")
}

model DirectPixTermsAcceptance {
  id             String                @id @default(uuid())
  termsVersionId String                @map("terms_version_id")
  termsVersion   DirectPixTermsVersion @relation(fields: [termsVersionId], references: [id], onDelete: Restrict)
  version        String
  actorUserId    String                @map("actor_user_id")
  actorUser      User                  @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  actorRole      UserRole              @map("actor_role")
  channel        String
  correlationId  String                @map("correlation_id")
  acceptedAt     DateTime              @default(now()) @map("accepted_at")

  @@unique([actorUserId, termsVersionId])
  @@index([actorUserId, acceptedAt])
  @@map("direct_pix_terms_acceptances")
}

model IdempotencyRecord {
  id             String    @id @default(uuid())
  actorUserId    String    @map("actor_user_id")
  actorUser      User      @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  operation      String
  idempotencyKey String    @map("idempotency_key")
  requestHash    String    @map("request_hash")
  resourceType   String?   @map("resource_type")
  resourceId     String?   @map("resource_id")
  status         String
  expiresAt      DateTime  @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")

  @@unique([actorUserId, operation, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_records")
}

enum OutboxEventState {
  PENDING
  PROCESSING
  PROCESSED
  DEAD_LETTER
}

enum JobRunStatus {
  CLAIMED
  PROCESSED
  RETRIED
  DEAD_LETTER
}

/// Transactionally written Direct Pix work. It intentionally stores opaque IDs only.
model DirectPixIntent {
  id                      String                @id @default(uuid())
  donorId                 String                @map("donor_id")
  donor                   User                  @relation(fields: [donorId], references: [id], onDelete: Restrict)
  familyId                String                @map("family_id")
  family                  Family                @relation(fields: [familyId], references: [id], onDelete: Restrict)
  responsibleAssignmentId String                @map("responsible_assignment_id")
  pixKeyVersionId         String                @map("pix_key_version_id")
  pixKeyVersion           DirectPixEvpKeyVersion @relation(fields: [pixKeyVersionId], references: [id], onDelete: Restrict)
  amountCents             Int                   @map("amount_cents")
  txid                    String                @unique
  status                  DirectPixIntentStatus @default(OPEN)
  cycleStartAt            DateTime              @map("cycle_start_at")
  cycleEndAt              DateTime              @map("cycle_end_at")
  firstDisclosedAt        DateTime?             @map("first_disclosed_at")
  lastDisclosureExpiresAt DateTime?             @map("last_disclosure_expires_at")
  declarationDeadlineAt   DateTime              @map("declaration_deadline_at")
  cycleId                 String?               @map("cycle_id")
  cohortCapturedAt        DateTime?             @map("cohort_captured_at")
  declaredAt              DateTime?             @map("declared_at")
  confirmationDeadlineAt  DateTime?             @map("confirmation_deadline_at")
  createdAt               DateTime              @default(now()) @map("created_at")
  disclosureGrants        PixDisclosureGrant[]
  declaration             DirectPixDeclaration?
  receiptConfirmation      DirectPixReceiptConfirmation?
  followUpCases            DirectPixFollowUpCase[]
  oldQrDeclaration          DirectPixOldQrDeclaration?
  @@index([donorId, createdAt])
  @@index([familyId, status])
  @@map("direct_pix_intents")
}

model PixDisclosureGrant {
  id             String          @id @default(uuid())
  intentId       String          @map("intent_id")
  intent         DirectPixIntent @relation(fields: [intentId], references: [id], onDelete: Restrict)
  actorUserId    String          @map("actor_user_id")
  actorUser      User            @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  purpose        String
  tokenHash      String          @unique @map("token_hash")
  expiresAt      DateTime        @map("expires_at")
  revokedAt      DateTime?       @map("revoked_at")
  lastAccessedAt DateTime?       @map("last_accessed_at")
  accessCount    Int             @default(0) @map("access_count")
  createdAt      DateTime        @default(now()) @map("created_at")
  @@index([intentId, actorUserId, expiresAt])
  @@map("pix_disclosure_grants")
}

model FamilySupportCycle {
  id           String                   @id @default(uuid())
  familyId     String                   @map("family_id")
  family       Family                   @relation(fields: [familyId], references: [id], onDelete: Restrict)
  cycleStartAt DateTime                 @map("cycle_start_at")
  cycleEndAt   DateTime                 @map("cycle_end_at")
  status       FamilySupportCycleStatus @default(IN_PROGRESS)
  blockedAt    DateTime                 @map("blocked_at")
  createdAt    DateTime                 @default(now()) @map("created_at")
  @@unique([familyId, cycleStartAt])
  @@map("family_support_cycles")
}

model DirectPixDeclaration {
  id               String          @id @default(uuid())
  intentId         String          @unique @map("intent_id")
  intent           DirectPixIntent @relation(fields: [intentId], references: [id], onDelete: Restrict)
  declaredByUserId String          @map("declared_by_user_id")
  declaredByUser   User            @relation(fields: [declaredByUserId], references: [id], onDelete: Restrict)
  declaredAt       DateTime        @default(now()) @map("declared_at")
  cancellation     DirectPixDeclarationCancellation?
  @@map("direct_pix_declarations")
}

/// Immutable withdrawal; the donor declaration remains auditable.
model DirectPixDeclarationCancellation {
  id               String                              @id @default(uuid())
  declarationId    String                              @unique @map("declaration_id")
  declaration      DirectPixDeclaration                @relation(fields: [declarationId], references: [id], onDelete: Restrict)
  canceledByUserId String                              @map("canceled_by_user_id")
  canceledByUser   User                                @relation(fields: [canceledByUserId], references: [id], onDelete: Restrict)
  reason           DirectPixDeclarationCancellationReason
  canceledAt       DateTime                            @default(now()) @map("canceled_at")
  @@map("direct_pix_declaration_cancellations")
}

/// An immutable family statement, never a bank-settlement assertion.
model DirectPixReceiptConfirmation {
  id                          String                    @id @default(uuid())
  intentId                    String                    @unique @map("intent_id")
  intent                      DirectPixIntent           @relation(fields: [intentId], references: [id], onDelete: Restrict)
  responsibleAssignmentId     String                    @map("responsible_assignment_id")
  outcome                     DirectPixReceiptOutcome
  receivedAmountCents         Int?                      @map("received_amount_cents")
  declaredByResponsibleUserId String                    @map("declared_by_responsible_user_id")
  declaredByResponsibleUser   User                      @relation("DirectPixReceiptDeclarant", fields: [declaredByResponsibleUserId], references: [id], onDelete: Restrict)
  recordedByOperatorUserId    String?                   @map("recorded_by_operator_user_id")
  recordedByOperatorUser      User?                     @relation("DirectPixReceiptOperator", fields: [recordedByOperatorUserId], references: [id], onDelete: Restrict)
  assistedChannel             DirectPixAssistedChannel? @map("assisted_channel")
  respondedAt                 DateTime                  @default(now()) @map("responded_at")
  @@index([responsibleAssignmentId, respondedAt])
  @@map("direct_pix_receipt_confirmations")
}

/// Entity-visible exception with structured reason and no financial evidence.
model DirectPixFollowUpCase {
  id       String                      @id @default(uuid())
  intentId String                      @map("intent_id")
  intent   DirectPixIntent             @relation(fields: [intentId], references: [id], onDelete: Restrict)
  familyId String                      @map("family_id")
  family   Family                      @relation(fields: [familyId], references: [id], onDelete: Restrict)
  reason   DirectPixFollowUpReason
  status   DirectPixFollowUpCaseStatus @default(OPEN)
  openedAt DateTime                    @default(now()) @map("opened_at")
  slaStartedAt DateTime?               @map("sla_started_at")
  escalatedAt DateTime?                @map("escalated_at")
  @@index([familyId, status, openedAt])
  @@index([intentId, status])
  @@map("direct_pix_follow_up_cases")
}

/// Donor-declared historical transfer made with a saved/expired direct-Pix QR.
/// It is not settlement evidence and deliberately has no upload or payment relation.
model DirectPixOldQrDeclaration {
  id                  String          @id @default(uuid())
  sourceIntentId      String          @unique @map("source_intent_id")
  sourceIntent        DirectPixIntent @relation(fields: [sourceIntentId], references: [id], onDelete: Restrict)
  declaredByUserId    String          @map("declared_by_user_id")
  amountCents         Int             @map("amount_cents")
  approximateSentAt   DateTime        @map("approximate_sent_at")
  pixKeyVersionId     String          @map("pix_key_version_id")
  sourceCycleId       String?         @map("source_cycle_id")
  createdAt           DateTime        @default(now()) @map("created_at")

  @@index([declaredByUserId, createdAt])
  @@map("direct_pix_old_qr_declarations")
}

model OutboxEvent {
  id              String          @id @default(uuid())
  eventType       String          @map("event_type")
  aggregateType   String          @map("aggregate_type")
  aggregateId     String          @map("aggregate_id")
  dedupeKey       String          @unique @map("dedupe_key")
  availableAt     DateTime        @default(now()) @map("available_at")
  attempts        Int             @default(0)
  state           OutboxEventState @default(PENDING)
  lockedAt        DateTime?       @map("locked_at")
  lockedBy        String?         @map("locked_by")
  leaseExpiresAt  DateTime?       @map("lease_expires_at")
  lastErrorCode   String?         @map("last_error_code")
  createdAt       DateTime        @default(now()) @map("created_at")
  processedAt     DateTime?       @map("processed_at")
  jobRuns         JobRun[]
  notifications   InAppNotification[]

  @@index([state, availableAt])
  @@index([state, leaseExpiresAt])
  @@index([availableAt, processedAt])
  @@map("outbox_events")
}

/// Canonical in-app notification, idempotent per outbox event and intentionally content-free.
model InAppNotification {
  id              String      @id @default(uuid())
  outboxEventId   String      @unique @map("outbox_event_id")
  outboxEvent     OutboxEvent @relation(fields: [outboxEventId], references: [id], onDelete: Cascade)
  recipientUserId String      @map("recipient_user_id")
  recipientUser   User        @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  eventType       String      @map("event_type")
  aggregateType   String      @map("aggregate_type")
  aggregateId     String      @map("aggregate_id")
  emailSentAt     DateTime?   @map("email_sent_at")
  createdAt       DateTime    @default(now()) @map("created_at")

  @@index([recipientUserId, createdAt])
  @@map("in_app_notifications")
}

/// Operational record containing timings and stable codes only; never PII, EVP, QR or free text.
model JobRun {
  id              String       @id @default(uuid())
  jobName         String       @map("job_name")
  outboxEventId   String       @map("outbox_event_id")
  outboxEvent     OutboxEvent  @relation(fields: [outboxEventId], references: [id], onDelete: Cascade)
  scheduledFor    DateTime     @map("scheduled_for")
  leaseOwner      String       @map("lease_owner")
  leaseExpiresAt  DateTime     @map("lease_expires_at")
  attempt         Int
  status          JobRunStatus @default(CLAIMED)
  startedAt       DateTime     @default(now()) @map("started_at")
  completedAt     DateTime?    @map("completed_at")
  durationMs      Int?         @map("duration_ms")
  errorCode       String?      @map("error_code")

  @@index([jobName, startedAt])
  @@index([outboxEventId, attempt])
  @@map("job_runs")
}
